# Native-run config for api/common (compose users: use the root .env instead).
PORT=8080
MONGODB_URL=mongodb://localhost:27017/expendit
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
# Ecosystem-standard CORS allowlist (comma-separated origins). The current
# middleware reflects any origin (flagged defect, engineering.md §CORS) —
# it adopts this var at first implementation touch.
CORS_ORIGINS=http://localhost:3000

# Client-IP attribution for rate limiting (same contract as cueprise).
# Leave disabled until the ingress ranges are verified: with false, buckets use
# the direct network peer, which is coarse behind shared ingress but can never
# be forged. See api/common/README.md §Trusted proxies.
TRUST_PROXY_HEADERS=false
# Comma-separated CIDRs whose X-Forwarded-For entries may be consumed, walked
# right to left. Cloud Run: the front end that terminates the connection, plus
# Cloudflare's published ranges (https://www.cloudflare.com/ips/).
TRUSTED_PROXY_CIDRS=
# Positional fallback for chains with no stable peer range. Keep 0: Cloud Run
# ingress is open, so the direct-to-origin chain is one hop shorter than the
# Cloudflare one and any fixed count reads a forged entry on one of them.
TRUSTED_PROXY_HOPS=0
# CIDRs where Cloudflare is the immediate peer and CF-Connecting-IP is
# authoritative (the self-hosted helm/compose path, not Cloud Run).
CLOUDFLARE_PROXY_CIDRS=
