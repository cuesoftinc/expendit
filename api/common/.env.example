# Native (non-compose) run: cp .env.example .env, then
#   set -a; . ./.env; set +a; go run ./cmd/server
# Names follow docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8080
CORS_ORIGINS=http://localhost:3000

# ── Postgres: api/common is its only client (S-2). Use a NON-superuser
# role: superusers bypass row-level security (S-11). ──
DATABASE_URL=postgres://expendit_app:expendit_app@localhost:5432/expendit?sslmode=disable

# ── Google sign-in: the API signs its own session JWT after Google. JWT_SECRET
#    is 32+ characters; SESSION_SECRET seals the token held for a handoff replay.
#    JWT_ACCESS_TTL is a Go duration (24h); JWT_EXPIRY_HOURS is the older hours form. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/google/callback
JWT_SECRET=
JWT_ACCESS_TTL=24h
# JWT_EXPIRY_HOURS=24
SESSION_SECRET=
SESSION_COOKIE_NAME=expendit_session
OAUTH_STATE_COOKIE=expendit_oauth_state

# ── Upload tickets (S-5): kid:<base64url Ed25519 seed>. Generate with
#    go run ./cmd/ticketkey  (gives the matching public key for statements) ──
UPLOAD_TICKET_PRIVATE_KEY=

# ── Kafka (compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# ── Redis: rate limits, quotas and pending sign-ins; unset = limits off and sign-in state in process ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
# Every key starts with this (the shared Valkey ACL allows expendit:* only).
REDIS_KEY_PREFIX=expendit

# ── Object storage: gcs (cloud, ADC) | s3 (SeaweedFS in compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=expendit-local
STORAGE_PREFIX=expendit/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── Cloud Scheduler calls POST /internal/jobs/<name> with an OIDC token; unset = 503.
#    Audience is the service URL, invoker is the scheduler's service account email. ──
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=

# ── Optional: lets the reaper power the shared Kafka service back on; unset = check skipped. ──
# AIVEN_API_TOKEN=
# AIVEN_PROJECT=
# AIVEN_KAFKA_SERVICE=

# ── Limits (engineering.md §3) ──
UPLOADS_PER_HOUR=10
UPLOADS_PER_DAY=30
UPLOAD_BYTES_PER_DAY=209715200
