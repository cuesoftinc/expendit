# Copy to .env for native (non-compose) local development.
PORT=8081
CORS_ORIGINS=http://localhost:3000

# Must match api/common's JWT_SECRET, so tokens issued there verify here too.
JWT_SECRET=dev-secret-change-me

# ── Aiven Kafka (pub/sub to api/process) ──
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=
