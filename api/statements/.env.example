# Native (non-compose) run: cp .env.example .env, then npm run dev. Names
# follow docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8081
CORS_ORIGINS=http://localhost:3000

# ── Upload tickets (S-5): kid:<base64url Ed25519 public key>[,…] ──
# Generate a pair in api/common: go run ./cmd/ticketkey
UPLOAD_TICKET_PUBLIC_KEYS=

# ── Kafka (compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# ── Object storage: gcs (cloud, ADC) | s3 (SeaweedFS in compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=expendit-local
STORAGE_PREFIX=expendit/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# The JSON Schemas; the image copies them to /app/contract.
CONTRACT_DIR=../common/contract
