# Native (non-compose) run: cp .env.example .env. Names follow
# docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8082
LOG_LEVEL=INFO

# extract | compute | all (compose and Helm run both pools in one process)
ANALYTICS_POOL=all

# ── Kafka (compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# ── Object storage: gcs (cloud, ADC) | s3 (SeaweedFS in compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=expendit-local
STORAGE_PREFIX=expendit/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# ── AI (X-4): Vertex in cloud; one key for self-host; none = no AI ──
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
GROQ_API_KEY=
GEMINI_API_KEY=

# The JSON Schemas; the image copies them to /app/contract.
CONTRACT_DIR=../common/contract
