# Native-run config for web (compose users: use the root .env instead).
# NEXT_PUBLIC_* are inlined at build time.
# TEST_MODE (web standard): 1 = Google button goes straight to /dashboard
# (no Firebase) and the API client targets the in-app mock server.
NEXT_PUBLIC_TEST_MODE=

# ── Real backend (TEST_MODE unset) ──
# Firebase web config (X-1). For local runs leave the key empty and point
# at the Auth emulator from docker compose.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-expendit
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Server-side: where /api/v1 is proxied (read at request time).
API_ORIGIN=http://localhost:8080
UPLOADS_ORIGIN=http://localhost:8081
