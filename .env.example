# expendit local development. Copy to .env: cp .env.example .env

# ── api/common (Go) ──
JWT_SECRET=dev-secret-change-me
FRONTEND_URL=http://localhost:3000

# ── Client-IP attribution for rate limiting ──
# Keep false until the ingress ranges are verified; buckets then use the direct
# network peer, which cannot be forged. api/common/README.md §Trusted proxies.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOPS=0
CLOUDFLARE_PROXY_CIDRS=

# ── Optional integrations (features degrade gracefully if unset) ──
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587

# MongoDB and Redis are provided by docker-compose (hosts: mongo, redis).
