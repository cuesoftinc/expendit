# Expendit local development (docker compose). Copy to .env: cp .env.example .env
# Variable names follow docs/system-design.md §10.3. Compose provides
# Postgres, Kafka, Redis, MinIO and the Firebase auth emulator; the defaults
# in docker-compose.yml point at them, so most lines here stay commented.

# ── Upload tickets (S-5): api/common signs, api/statements verifies ──
# LOCAL DEVELOPMENT ONLY. Never reuse this pair anywhere else; generate real
# keys with: cd api/common && go run ./cmd/ticketkey <kid>
UPLOAD_TICKET_PRIVATE_KEY=local-dev:W5AtEnESCIC9JxoKxY4Czolev7kdSAvbY93O5DxMTM8
UPLOAD_TICKET_PUBLIC_KEYS=local-dev:oA2pPpNml2AJMqoeuLThKxWOJ69e5UhXCQ3Z9AIy1xQ

# ── Browser origins allowed by common and statements ──
CORS_ORIGINS=http://localhost:3000

# ── Firebase (X-1). The emulator is used while FIREBASE_AUTH_EMULATOR_HOST
# is set (compose default); set it empty and use a real project id to verify
# real Google sign-in tokens. ──
FIREBASE_PROJECT_ID=demo-expendit
# FIREBASE_AUTH_EMULATOR_HOST=

# ── Self-host AI (X-4). Optional: without a key, CSV and PDF (regex) imports
# work and receipt images fail with ai_unavailable. Cloud uses Vertex via ADC. ──
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Overrides for managed services (leave unset for compose) ──
# KAFKA_BROKERS=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SSL_CA=
# REDIS_HOST=
# STORAGE_DRIVER=gcs
# STORAGE_BUCKET=
# STORAGE_PREFIX=expendit/stg
